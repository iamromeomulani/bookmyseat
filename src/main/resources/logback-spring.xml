<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- One JSON object per line on stdout. MDC entries (request_id) become top-level fields. -->
    <appender name="JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LogstashEncoder">
            <customFields>{"service":"bookmyseat"}</customFields>
        </encoder>
    </appender>

    <root level="INFO">
        <appender-ref ref="JSON"/>
    </root>
</configuration>
